table cleaned_customers
	lineageTag: ef72e45c-c115-4533-9684-a53d76240b5d

	measure 'Total Profit' = SUM(cleaned_order_items[LineProfit])
		formatString: ₹#,##0.00
		lineageTag: aa7feafc-e36d-43ae-a895-6f237816675b

	measure 'Total Revenue' = SUM(cleaned_order_items[LineTotal])
		formatString: ₹#,##0.00
		lineageTag: 132b4cad-6132-4bf4-a66d-1507c6f2e247

	measure 'Total Orders' = DISTINCTCOUNT(cleaned_orders[OrderID])
		formatString: #,##0
		lineageTag: c0a25740-c468-4f8f-b605-1764c0b8f735

	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders], 0)
		formatString: ₹#,##0.00
		lineageTag: 47a99158-9181-4304-8ccc-f91d3e1c77db

