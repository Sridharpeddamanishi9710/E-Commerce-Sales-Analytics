{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "chart_regional_performance",
  "position": {
    "x": 1050,
    "y": 295,
    "z": 10000,
    "height": 370,
    "width": 840,
    "tabOrder": 10000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "cleaned_regions"
                    }
                  },
                  "Property": "RegionName"
                }
              },
              "queryRef": "cleaned_regions.RegionName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "cleaned_customers"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "cleaned_customers.Total Revenue"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "cleaned_customers"
                    }
                  },
                  "Property": "Total Profit"
                }
              },
              "queryRef": "cleaned_customers.Total Profit"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "cleaned_customers"
                  }
                },
                "Property": "Total Revenue"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue vs Profit by Region'"
                }
              }
            }
          }
        }
      ]
    }
  }
}